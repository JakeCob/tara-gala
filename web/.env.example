NEXT_PUBLIC_API_URL=http://localhost:8000
# Feature flags (README section 7), baked in at build time
NEXT_PUBLIC_PLANNER_LIVE=false
NEXT_PUBLIC_PREMADE_ITINERARIES=true
NEXT_PUBLIC_REAL_MAP=false
NEXT_PUBLIC_PLAN_EDITING=false
# TG-66 wallet splitting; turn the API's on first, and these off first on a rollback
NEXT_PUBLIC_WALLET_SPLITS=false
NEXT_PUBLIC_WALLET_MULTI_PAYER=false
NEXT_PUBLIC_WALLET_ACTIVITY=false
NEXT_PUBLIC_CHATBOT_LIVE=false
# The chatbot on a Sagada (or any served city's) plan, not only Baguio; needs NEXT_PUBLIC_CHATBOT_LIVE; turn the API's CHAT_ALL_CITIES on first
NEXT_PUBLIC_CHAT_ALL_CITIES=false
# TG-62 budget vs actual (the wallet's line pick, the trip's Budget panel); on only after the WALLET_SPLITS flags
NEXT_PUBLIC_BUDGET_LINES=false
# TG-64 the recap link: the trip page's Trip recap box and /r/<slug>; turn the API's RECAP_LINKS on first
NEXT_PUBLIC_RECAP_LINKS=false
# TG-70 offline expenses: Add expense with no signal waits here and sends itself; needs NEXT_PUBLIC_WALLET_SPLITS, and the API's TG-70 add on Railway first
NEXT_PUBLIC_OFFLINE_EXPENSES=false
# Service worker and offline caches; false unregisters it and deletes saved data on every phone
NEXT_PUBLIC_SERVICE_WORKER=true
# The overworld map on /i/[slug]; false shows the plain list instead
NEXT_PUBLIC_OVERWORLD_MAP=true
# TG-71/72 the Around tab (Baguio and Sagada pages) and site words that aren't only Manila to Baguio; web only
NEXT_PUBLIC_AROUND_TAB=false
# TG-72 the Ambagan tab: the shared wallets' own tab and words; web only
NEXT_PUBLIC_AMBAGAN_TAB=false
# TG-71 the Going to city picker (Baguio, Sagada) on /buses and on /plan's ready-made trips; web only
NEXT_PUBLIC_GOING_TO=false
# TG-75 Kaloy, the chatbot carabao: the chat's name, greeting and poses, the title screen walk and the sad and empty boxes; web only
NEXT_PUBLIC_KALOY=false
# TG-75 the game-style Ask Kaloy chat: Kaloy's lines in pixel speech bubbles, yours on the right, a one-row text entry; needs NEXT_PUBLIC_KALOY; web only
NEXT_PUBLIC_CHAT_GAME_UI=false
# TG-75 the floating Ask Kaloy button at the trip page's bottom-right (opens the chat without Edit the plan); needs NEXT_PUBLIC_KALOY and the chat's flags; web only
NEXT_PUBLIC_KALOY_FAB=false
# TG-75: Ask Kaloy on the home page too, opening the last trip this phone opened with the chat open; needs NEXT_PUBLIC_KALOY_FAB
NEXT_PUBLIC_KALOY_FAB_HOME=false
