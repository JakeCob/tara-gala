NEXT_PUBLIC_API_URL=http://localhost:8000
# Feature flags (README section 7), baked in at build time
NEXT_PUBLIC_PLANNER_LIVE=false
NEXT_PUBLIC_PREMADE_ITINERARIES=true
NEXT_PUBLIC_REAL_MAP=false
# Service worker and offline caches; false unregisters it and deletes saved data on every phone
NEXT_PUBLIC_SERVICE_WORKER=true
