# Copy to .env (never commit .env)

# --- API (api/) and data loader (data/) ---
# Supabase > Project Settings > Database > Connection string (URI).
# Use the session pooler URI on Railway. Keep the password secret.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# On Railway, `api` uses the reference ${{Postgres.DATABASE_URL}} (README section 8).

# Comma-separated origins allowed to call the API (the web app's URLs)
ALLOWED_ORIGINS=http://localhost:3000

# API log level: DEBUG, INFO (default), WARNING, ERROR or CRITICAL (README section 5)
LOG_LEVEL=INFO

# Live AI planner, POST /plan (TG-20; docs/decisions/TG-19-llm-provider.md). Set the key on Railway only.
LLM_API_KEY=
# anthropic (key from console.anthropic.com) or openrouter (OpenRouter key)
LLM_PROVIDER=anthropic
# Model ids depend on the provider. Leave both unset for the defaults:
#   anthropic:  claude-haiku-5-5 / claude-sonnet-5-5
#   openrouter: anthropic/claude-haiku-5.5 / anthropic/claude-sonnet-5.5
# LLM_MODEL=claude-haiku-5-5
# LLM_FALLBACK_MODEL=claude-sonnet-5-5
# Planner knobs; the defaults are shown. Bad values fall back to the default with a warning.
# LLM_EFFORT=low
# LLM_MAX_TOKENS=8000
# LLM_TIMEOUT_SECONDS=40
# PLANNER_MAX_ATTEMPTS=3
# PLANNER_DEADLINE_SECONDS=100
# PLANNER_DAILY_SPEND_CAP_USD=1.00
# PLANNER_RATE_LIMIT_PER_HOUR=10

# Feature flags (README section 7)
PLANNER_LIVE=false
PREMADE_ITINERARIES=true
REAL_MAP=false

# --- Web (web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Feature flags (README section 7), baked in at build time
NEXT_PUBLIC_PLANNER_LIVE=false
NEXT_PUBLIC_PREMADE_ITINERARIES=true
NEXT_PUBLIC_REAL_MAP=false
